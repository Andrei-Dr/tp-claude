# --- --lean: what a package manager can rebuild -----------------------------
#
# Dependency trees and build output are the bulk of most projects and the least
# worth moving: they are derived from files that DO travel (a lockfile, a
# manifest), they are frequently the wrong architecture for the destination --
# a mac's node_modules carries darwin-arm64 binaries a linux box cannot load --
# and they are regenerated by one command on the other side.
#
# Two decisions keep this from destroying work:
#
# Rules are ECOSYSTEM-GATED. `vendor/` means "installed by Composer" next to a
# composer.json and "a directory I named vendor" otherwise; `target/` is Rust's
# build output only next to a Cargo.toml. Firing on the name alone would delete
# somebody's source, so each rule declares the manifest that proves the
# directory is derived.
#
# Rules are PATH-SCOPED. Laravel's storage/ holds regenerable caches and logs
# next to storage/app, which is user uploads that no reinstall can bring back.
# So the patterns name storage/logs and storage/framework, never storage
# itself. Anchoring works the same way: `/vendor/` is the Composer one at the
# repo root, while a `resources/vendor/` of hand-written source is untouched.
# node_modules is deliberately NOT anchored -- workspaces nest one per package
# and all of them are derived.
LeanRule = namedtuple("LeanRule", "name needs patterns why")

LEAN_RULES = (
    # Nothing else in common use names a directory node_modules, so this is the
    # one dependency rule that needs no manifest to prove itself.
    LeanRule("node", (), ("node_modules/",),
             "npm/yarn/pnpm packages"),
    # Composer and `go mod vendor` share the name and the meaning.
    LeanRule("php", ("composer.json",), ("/vendor/",),
             "Composer packages"),
    LeanRule("go", ("go.mod",), ("/vendor/",),
             "vendored Go modules"),
    LeanRule("rust", ("Cargo.toml",), ("/target/",),
             "Cargo build output"),
    # A venv is the weakest case for rebuilding -- see reconstructability()
    # below -- but the strongest case for not copying: it hard-codes the
    # interpreter's absolute path, so it arrives broken no matter what.
    LeanRule("python", ("pyproject.toml", "requirements.txt", "setup.py",
                        "Pipfile", "setup.cfg"),
             (".venv/", "venv/", "__pycache__/", "*.pyc", ".tox/",
              ".mypy_cache/", ".ruff_cache/"),
             "virtualenvs and bytecode"),
    LeanRule("ruby", ("Gemfile",), (".bundle/", "/vendor/bundle/"),
             "bundled gems"),
    # Framework caches keyed to the machine that built them.
    LeanRule("laravel", ("artisan",),
             ("/bootstrap/cache/", "/storage/framework/", "/storage/logs/"),
             "compiled views, sessions and logs"),
    # Build output. Gated on a manifest so a `dist/` of hand-written files in a
    # plain directory is never mistaken for something a build produced.
    LeanRule("build", ("package.json", "Cargo.toml", "go.mod",
                       "composer.json", "pyproject.toml"),
             (".turbo/", ".next/", ".nuxt/", ".svelte-kit/", ".parcel-cache/",
              "/dist/", "/build/", "/out/"),
             "build output"),
    LeanRule("cache", (), (".cache/", ".npm/", ".pytest_cache/",
                           ".php-cs-fixer.cache", ".phpunit.cache",
                           ".phpunit.result.cache", "coverage/",
                           ".gradle/", ".DS_Store"),
             "tool caches"),
)

# Agent worktrees are git checkouts made on this machine, naming this machine's
# paths and pids. They are not build output and not dependencies, so they get
# their own flag rather than riding along with --lean.
#
# Deliberately unanchored, unlike the rules above: a worktree is machine-local
# wherever it sits, so one nested in a workspace package arrives just as broken
# as one at the root. There is no ambiguous case to protect here -- the path is
# specific enough that nothing else can collide with it.
WORKTREE_PATTERNS = (".claude/worktrees/",)


def lean_rules(present: set) -> tuple:
    """The rules that apply to a tree containing the manifest files `present`.

    A rule with no `needs` always applies; otherwise at least one of its
    manifests has to be there to prove the directory is derived rather than
    written by hand.
    """
    return tuple(rule for rule in LEAN_RULES
                 if not rule.needs or any(n in present for n in rule.needs))


def rule_patterns(rules) -> list:
    """Flatten rules to rsync patterns, keeping order and dropping repeats
    (php and go both contribute /vendor/)."""
    seen, out = set(), []
    for rule in rules:
        for pattern in rule.patterns:
            if pattern not in seen:
                seen.add(pattern)
                out.append(pattern)
    return out


# Manifests worth noticing when deciding which rules apply. Kept small and
# top-level: a deep walk of a tree that still contains node_modules would spend
# minutes finding manifests belonging to dependencies rather than the project.
MANIFEST_FILES = ("package.json", "composer.json", "go.mod", "Cargo.toml",
                  "pyproject.toml", "requirements.txt", "setup.py", "Pipfile",
                  "setup.cfg", "Gemfile", "artisan")

# A manifest is only a promise that something CAN be reinstalled; the lockfile
# is what pins it to the same versions. Each manifest names the lockfiles that
# would satisfy it.
LOCKFILES = {
    "package.json": ("pnpm-lock.yaml", "package-lock.json", "yarn.lock",
                     "bun.lockb", "bun.lock", "npm-shrinkwrap.json"),
    "composer.json": ("composer.lock",),
    "Cargo.toml": ("Cargo.lock",),
    "go.mod": ("go.sum",),
    "Gemfile": ("Gemfile.lock",),
    "Pipfile": ("Pipfile.lock",),
    "pyproject.toml": ("poetry.lock", "pdm.lock", "uv.lock",
                       "requirements.txt"),
}

Reconstructability = namedtuple("Reconstructability", "warnings manager")


def _lock_above(base: str, root: str, wanted) -> bool:
    """True if one of `wanted` sits at `base` or any directory up to `root`."""
    base, root = base.rstrip("/"), root.rstrip("/")
    while True:
        if any(os.path.exists(os.path.join(base, lock)) for lock in wanted):
            return True
        if base == root or not base.startswith(root):
            return False
        parent = os.path.dirname(base)
        if parent == base:
            return False
        base = parent


def _find_manifests(root: str, max_depth: int = 3) -> list:
    """Manifest files in the tree, skipping anything a lean rule would drop.

    Bounded in depth and pruned of dependency directories because the tree
    being examined usually still HAS its node_modules -- walking into it would
    find thousands of manifests belonging to packages, not to the project.

    `max_depth` counts directory names below `root`, so the default reaches
    a/b/c but not a/b/c/d -- comfortably past a monorepo's apps/web while
    stopping well short of a dependency tree. The skip set below does the real
    pruning; the bound is just a backstop.
    """
    skip = {"node_modules", "vendor", ".git", "target", ".venv", "venv",
            ".turbo", ".next", "dist", "build", "__pycache__", ".cache"}
    found = []
    root = root.rstrip("/")
    for dirpath, dirnames, filenames in os.walk(root):
        depth = dirpath[len(root):].count("/")
        if depth >= max_depth:
            dirnames[:] = []
        dirnames[:] = [d for d in dirnames if d not in skip]
        for name in filenames:
            if name in MANIFEST_FILES:
                found.append(os.path.join(dirpath, name))
    return found


def _json_or_none(path: str):
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def _local_dep_warnings(rel: str, deps: dict, base: str, root: str) -> list:
    """Flag deps resolved from a path rather than a registry.

    `file:` and `link:` deps point at a directory. If that directory is inside
    the tree being synced it travels along and the reinstall works; if it is
    outside, the destination has nothing to install from and the dep is simply
    gone.
    """
    out = []
    for name, spec in (deps or {}).items():
        if not isinstance(spec, str):
            continue
        for prefix in ("file:", "link:", "portal:"):
            if not spec.startswith(prefix):
                continue
            target = os.path.normpath(
                os.path.join(base, spec[len(prefix):]))
            if not (target + "/").startswith(root.rstrip("/") + "/"):
                out.append(f"{rel}  ->  \"{name}\": \"{spec}\"\n"
                           f"      resolves outside the synced tree; "
                           f"a reinstall cannot rebuild it")
    return out


def reconstructability(root: str) -> Reconstructability:
    """Can the directories --lean would skip be rebuilt on the destination?

    Returns the specific reasons they might not be, alongside the package
    manager to suggest. Reporting beats refusing: the answer is a judgement
    about someone else's project, and the cases below are heuristics, not
    proof. The caller prints these and carries on.
    """
    root = root.rstrip("/")
    warnings, manager = [], None

    for manifest in sorted(_find_manifests(root)):
        base = os.path.dirname(manifest)
        rel = os.path.relpath(manifest, root)
        kind = os.path.basename(manifest)

        # Look for the lockfile from the manifest up to the root: in a
        # workspace only the root carries one, and the packages under it are
        # covered by it rather than each holding a copy.
        wanted = LOCKFILES.get(kind, ())
        if wanted and not _lock_above(base, root, wanted):
            warnings.append(
                f"{rel}  ->  no lockfile beside it "
                f"(looked for {', '.join(wanted)})\n"
                f"      versions are unpinned, so a reinstall may not "
                f"reproduce this tree")

        if kind == "package.json":
            data = _json_or_none(manifest) or {}
            if manager is None:
                pm = data.get("packageManager")
                if isinstance(pm, str) and pm:
                    manager = pm.split("@", 1)[0]
            for field_name in ("dependencies", "devDependencies",
                               "optionalDependencies"):
                warnings += _local_dep_warnings(rel, data.get(field_name),
                                                base, root)
            patched = (data.get("pnpm") or {}).get("patchedDependencies")
            if patched:
                warnings.append(
                    f"{rel}  ->  pnpm patchedDependencies "
                    f"({', '.join(sorted(patched))})\n"
                    f"      the patch files must travel for the reinstall "
                    f"to match")

        if kind == "composer.json":
            data = _json_or_none(manifest) or {}
            repos = data.get("repositories") or []
            entries = repos.values() if isinstance(repos, dict) else repos
            for repo in entries:
                if isinstance(repo, dict) and repo.get("type") == "path":
                    url = repo.get("url", "")
                    target = os.path.normpath(os.path.join(base, url))
                    if not (target + "/").startswith(root + "/"):
                        warnings.append(
                            f"{rel}  ->  path repository \"{url}\"\n"
                            f"      resolves outside the synced tree; "
                            f"composer cannot install from it there")

    # A venv with nothing declaring its contents is unrebuildable outright --
    # and it was already broken on arrival, since it hard-codes the source
    # machine's interpreter path.
    for venv in (".venv", "venv"):
        if not os.path.isdir(os.path.join(root, venv)):
            continue
        declares = ("pyproject.toml", "requirements.txt", "Pipfile",
                    "setup.py", "setup.cfg")
        if not any(os.path.exists(os.path.join(root, d)) for d in declares):
            warnings.append(
                f"{venv}/  ->  nothing declares what is installed in it\n"
                f"      no requirements.txt or pyproject.toml to rebuild "
                f"from")

    return Reconstructability(warnings, manager)

# Sessions are not the only thing keyed by absolute path. ~/.claude.json holds a
# `projects` map whose entries carry the trust decision, granted tool
# permissions, per-project MCP servers and ignore patterns; ~/.claude/
# history.jsonl tags each recalled prompt with the project it was typed in.
# Without these the code and transcripts arrive but the project behaves like it
# has never been opened -- trust dialog again, permissions re-prompted.
#
# Per-run measurements are deliberately left behind: they describe the machine
# that produced them, not the project. Anything else is carried over, so
# settings added by future releases travel without needing this list updated.
VOLATILE_SETTINGS = {"exampleFiles", "exampleFilesGeneratedAt",
                     "reactVulnerabilityCache"}
DURABLE_LAST_KEYS = {"lastSessionId"}


def durable_settings(entry: dict) -> dict:
    return {
        key: value for key, value in entry.items()
        if key not in VOLATILE_SETTINGS
        and (not key.startswith("last") or key in DURABLE_LAST_KEYS)
    }


def apply_subs(text: str, subs) -> str:
    """Rewrite paths in `text`, matching the rule the session rewriter uses:
    only at a path boundary, so '/a/app' never mangles '/a/app2'."""
    for old, new in subs:
        text = re.sub(re.escape(old) + r"(?![A-Za-z0-9._-])",
                      lambda _m, replacement=new: replacement, text)
    return text


# Helper programs run on whichever machine owns the files. Kept as templates
# rather than nested f-strings so the quoting stays readable.

# Claude Code keeps the snapshots behind /rewind in
# <config>/file-history/<session id>/<sha256(absolute file path)[:16]>@v<n>.
# The session ids travel with the transcripts, but the entry names are derived
# from the source machine's paths, so copying them unchanged would orphan every
# one. Knowing the rule, they can simply be re-keyed to the new paths instead.
HISTORY_PLAN = """
import hashlib, json, os

SRC_DIR = %(src_dir)s
DEST_DIR = %(dest_dir)s
ROOT = os.path.join(%(config)s, "file-history")


def key(path):
    return hashlib.sha256(path.encode()).hexdigest()[:16]


# Every file still present in the project, by the name its snapshots carry.
rename = {}
for dirpath, dirnames, filenames in os.walk(SRC_DIR):
    dirnames[:] = [d for d in dirnames if d not in (".git", "node_modules")]
    for name in filenames:
        full = os.path.join(dirpath, name)
        rename[key(full)] = key(DEST_DIR + full[len(SRC_DIR):])

plan = []
for session in %(sessions)s:
    folder = os.path.join(ROOT, session)
    try:
        entries = os.listdir(folder)
    except OSError:
        continue
    for entry in entries:
        stem, sep, version = entry.partition("@")
        target = rename.get(stem)
        if not target:
            continue          # file since deleted or renamed: nothing to re-key
        plan.append(["file-history/%%s/%%s" %% (session, entry),
                     "file-history/%%s/%%s" %% (session, target + sep + version)])
print("tp<" + json.dumps(plan) + ">tp")
"""

HISTORY_RENAME = """
import base64, json, os, shutil
ROOT = %(config)s
plan = json.loads(base64.b64decode(%(plan)s).decode())
KEEP_ORIGINAL = %(keep)s        # source and destination share this directory
moved = 0
for old, new in plan:
    source = os.path.join(ROOT, old)
    target = os.path.join(ROOT, new)
    if source == target:
        moved += 1
        continue
    try:
        if KEEP_ORIGINAL:
            # Relocating within one machine: the entry under the old name is
            # the source project's own, and moving it would take its history
            # away.
            shutil.copy2(source, target)
        else:
            os.replace(source, target)
            
        moved += 1
    except OSError:
        pass
print("tp<" + json.dumps({"moved": moved}) + ">tp")
"""

